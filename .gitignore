# Runtime data — contains your Slack/journal/session content. Never commit.
logs/
feed.log
*.log
*.err
.loop-state.json

# Python
.venv/
__pycache__/
*.pyc

# Secrets (sourced from ~/.claude/.env at runtime — never in the repo)
.env

# Runtime heartbeat + macOS cruft
.status
.DS_Store

# Build artifacts (the compiled .app / .dmg — rebuild with app/make-app.sh)
app/build/
app/*.iconset
