# Runtime data — contains your Slack/journal/session content. Never commit.
logs/
feed.log
.embed-cache.json
*.log
*.err
.loop-state.json

# Python
.venv/
.venv
__pycache__/
*.pyc

# Secrets (sourced from ~/.claude/.env at runtime — never in the repo)
.env

# Machine-specific config written by install.sh (vault location etc.)
config.env

# Runtime heartbeat + macOS cruft
.status
.DS_Store

# Build artifacts (the compiled .app / .dmg — rebuild with app/make-app.sh)
app/build/
app/build-cache/
app/*.iconset
.achievements.json
.funfacts.json
.patterns.json
