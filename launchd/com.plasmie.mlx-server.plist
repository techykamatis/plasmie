<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.plasmie.mlx-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__DATA__/venv/bin/python</string>
        <string>__LOOP_DIR__/mlx_serve.py</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8091</string>
    </array>
    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__LOGS__/mlx-server.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/mlx-server.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
